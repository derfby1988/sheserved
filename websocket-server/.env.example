# ─────────────────────────────────────────────────────────────
# Sheserved WebSocket Server — Environment Variables Template
# Plan 07 Option D: Secret Management (backend .env baseline)
# ─────────────────────────────────────────────────────────────
# Copy this file to `.env` and fill in real values.
# NEVER commit `.env` — it is in .gitignore.
# Production .env must have file permission 600.

# ── Runtime Environment ──
NODE_ENV=development
PORT=3000

# ── Database (P2 — server-only) ──
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sheserved
DB_USER=postgres
DB_PASSWORD=changeme
DB_POOL_MAX=20
DB_STATEMENT_TIMEOUT_MS=30000

# ── CORS (P0 — public config, but must not be '*' in production) ──
ALLOWED_ORIGINS=*

# ── Supabase (P1 — client-embedded, protected by RLS) ──
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# ── Supabase Service Role (P2 — server-only; required for sync/jobs) ──
# Phase 13.0: No silent fallback to anon key. Must be set in production.
SUPABASE_SERVICE_KEY=your-service-role-key
# Alternative: SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Supabase JWT for short-lived PostgREST tokens (Q7-C / Phase 13.2) ──
# Must match the project's JWT secret. Used only by Backend to mint ≤5-minute tokens.
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# ── Sheserved access/refresh JWT (Phase 13.0 / 13.2) ──
# HS256 dual-key. Use permission 600; rotate every 90 days per docs/secure/07_secret_management.md.
JWT_ACTIVE_KID=active-1
JWT_ACTIVE_SECRET=change-me-to-256-bit-secret-1
JWT_PREVIOUS_KID=previous-1
JWT_PREVIOUS_SECRET=change-me-to-256-bit-secret-2
JWT_ISSUER=sheserved
JWT_AUDIENCE=sheserved-app
ACCESS_TTL=900
REFRESH_TTL=604800

# ── Redis (P2 — server-only) ──
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── Video Storage ──
TEMP_VIDEO_PATH=
BUNNY_CDN_API_KEY=
BUNNY_CDN_URL=
BUNNY_CDN_STORAGE_ZONE=

# ── Proxy / Network ──
TRUST_PROXY_HOPS=1
LOCAL_API_URL=

# ── Caddy Staging (Phase 13.0) ──
# ใช้กับ Caddyfile.staging เท่านั้น — ตั้งค่าจริงก่อน deploy staging
# CADDY_STAGING_DOMAIN ต้องชี้ A/CNAME record มาที่เครื่องนี้
CADDY_STAGING_DOMAIN=staging.sheserved.example.com
CADDY_ACME_EMAIL=admin@sheserved.example.com

# ── Feature Toggles ──
USE_DATABASE=true
