# ─────────────────────────────────────────────────────────────
# Sheserved WebSocket Server — Environment Variables Template
# Plan 07 Option D: Secret Management (backend .env baseline)
# ─────────────────────────────────────────────────────────────
# Copy this file to `.env` and fill in real values.
# NEVER commit `.env` — it is in .gitignore.
# Production .env must have file permission 600.

# ── Runtime Environment ──
NODE_ENV=development
PORT=3000

# ── Database (P2 — server-only) ──
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sheserved
DB_USER=postgres
DB_PASSWORD=changeme
DB_POOL_MAX=20
DB_STATEMENT_TIMEOUT_MS=30000

# ── CORS (P0 — public config, but must not be '*' in production) ──
ALLOWED_ORIGINS=*

# ── Supabase (P1 — client-embedded, protected by RLS) ──
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# ── Redis (P2 — server-only) ──
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── Video Storage ──
TEMP_VIDEO_PATH=
BUNNY_CDN_API_KEY=
BUNNY_CDN_URL=
BUNNY_CDN_STORAGE_ZONE=

# ── Proxy / Network ──
TRUST_PROXY_HOPS=1
LOCAL_API_URL=

# ── Feature Toggles ──
USE_DATABASE=true
