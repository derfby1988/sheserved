# =============================================================
# Caddyfile.staging — TLS/HTTPS for Phase 13.0 staging
# ใช้สำหรับ: staging environment ที่ต้องการ HTTPS/WSS จริง
# รัน: caddy run --config Caddyfile.staging --adapter caddyfile
#
# Prerequisites:
#   1. Domain ชี้มาที่เครื่องนี้ (A record หรือ CNAME)
#   2. Caddy จะ auto-provision Let's Encrypt certificate
#   3. Port 443 เปิด (ต้อง sudo หรือ setcap)
#
# Phase 13.0: TLS เป็น hard prerequisite ของ 13.2 (auth endpoint)
# =============================================================

{
	admin off
	# Phase 13.0: staging domain/ACME email มาจาก env (ไม่ hardcode ใน repo)
	# ตั้งค่าจริงใน .env ก่อน deploy: CADDY_STAGING_DOMAIN, CADDY_ACME_EMAIL
	email {$CADDY_ACME_EMAIL}
}

{$CADDY_STAGING_DOMAIN} {
	log {
		output stdout
		format console
		level INFO
	}

	header {
		-Server
		X-Powered-By "Sheserved-Proxy"
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	# Auth endpoints — strict limit
	@auth path /api/auth/* /api/login /api/register /api/otp/* /api/verify* /api/reset*
	handle @auth {
		reverse_proxy localhost:3000
	}

	# Upload endpoints — low rate, larger body
	@upload path_regexp ^/api/.*upload
	handle @upload {
		request_body {
			max_size 25MB
		}
		reverse_proxy localhost:3000
	}

	# Emergency endpoints — high burst
	@emergency path_regexp ^/api/.*emergency
	handle @emergency {
		reverse_proxy localhost:3000
	}

	# WebSocket — WSS (secure WebSocket)
	handle /socket.io/* {
		reverse_proxy localhost:3000
	}

	# Default API
	handle {
		reverse_proxy localhost:3000 {
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}
}

# =============================================================
# Flutter Web build — W4.2 (staging/prod)
# เสิร์ฟ build/web ผ่าน HTTPS — TLS auto-provision เหมือน site บน
# ตั้ง env ก่อน deploy: CADDY_WEB_DOMAIN (ชี้ A/CNAME มาเครื่องนี้),
#   CADDY_WEB_ROOT (path ของ build/web บนเครื่องนี้)
# domain จริง: admin.sheserved.me (deploy ผ่าน Cloudflare Tunnel 2026-10-09)
# =============================================================
{$CADDY_WEB_DOMAIN} {
	log {
		output stdout
		format console
		level INFO
	}

	root * {$CADDY_WEB_ROOT}
	encode zstd gzip

	# ── Security headers + CSP (W4.4) — production variant ──
	# connect-src ใช้ https/wss เท่านั้น (W4.3 — web https → backend https)
	# backend = {$CADDY_STAGING_DOMAIN} (API + socket.io ผ่าน site block บน)
	header {
		-Server
		X-Powered-By "Sheserved-Proxy"
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://unpkg.com https://accounts.google.com/gsi/client; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' https://{$CADDY_STAGING_DOMAIN} wss://{$CADDY_STAGING_DOMAIN} https://psxcgdwcwjdbpaemkozq.supabase.co wss://psxcgdwcwjdbpaemkozq.supabase.co https://accounts.google.com https://www.googleapis.com https://unpkg.com https://fonts.googleapis.com https://fonts.gstatic.com; frame-src https://accounts.google.com; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
	}

	# ── Cache profile (W4.6) — matchers disjoint เหมือน dev block ──
	@notStatic not path /canvaskit/* /assets/* /icons/*
	header @notStatic Cache-Control "no-cache"

	@static path /canvaskit/* /assets/* /icons/*
	header @static Cache-Control "public, max-age=86400"

	# ── Deep-link landing (Phase 23 share links) — เหมือน Caddyfile.dev ──
	# /emergency/* + /sport-club/* → /landing/index.html (มีปุ่มเปิดแอป/เปิดเว็บ)
	@deeplinkLanding path /emergency/* /sport-club/*
	rewrite @deeplinkLanding /landing/index.html

	try_files {path} /index.html
	file_server
}
