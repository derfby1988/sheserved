# =============================================================
# cloudflared config — W4.2 Option B (Cloudflare Tunnel)
# =============================================================
# คัดลอกไปที่ ~/.cloudflared/config.yml แล้วแทน <TUNNEL_ID>
# (ของจริงที่ใช้อยู่: tunnel `sheserved` id c5ec3c98-abf3-46f3-a6f6-8142b3343f8c,
#  deploy แล้ว 2026-10-09 — ไฟล์นี้เป็น template สำหรับ rebuild/เครื่องใหม่)
#
# Architecture:
#   Internet → Cloudflare edge (TLS จบที่นี่) → tunnel
#     admin.sheserved.me → http://localhost:8081 (Caddy → build/web)
#     sheserved.me       → http://localhost:8081 (root — deep-link landing,
#                          SPA fallback รับ /emergency/incident/* /sport-club/*
#                          + .well-known/apple-app-site-association, assetlinks.json)
#     api.sheserved.me   → http://localhost:8080 (Caddy → node:3000,
#                          รวม /socket.io — tunnel รองรับ WebSocket โดยอัตโนมัติ)
#
# Setup (ครั้งเดียว):
#   1. cloudflared tunnel login            # เปิด browser เลือก sheserved.me
#   2. cloudflared tunnel create sheserved # → ได้ TUNNEL_ID + <TUNNEL_ID>.json
#   3. cloudflared tunnel route dns sheserved admin.sheserved.me
#      cloudflared tunnel route dns sheserved sheserved.me
#      cloudflared tunnel route dns sheserved api.sheserved.me
#   4. cp cloudflared/config.yml.example ~/.cloudflared/config.yml (แทน TUNNEL_ID)
#   5. ทดสอบ: cloudflared tunnel run sheserved
#   6. ติดตั้งเป็น service: cloudflared service install  (ไม่ต้อง sudo —
#      user launch agent; ⚠️ bug cloudflared 2026.9.3: plist ที่สร้างใส่
#      bare `cloudflared` ไม่มี `tunnel run` → exit+respawn วน ต้องแก้
#      ProgramArguments ใน ~/Library/LaunchAgents/com.cloudflare.cloudflared.plist
#      เพิ่ม <string>tunnel</string><string>run</string> แล้ว bootout+bootstrap ใหม่)
# =============================================================

tunnel: <TUNNEL_ID>
credentials-file: /Users/dave_macmini/.cloudflared/<TUNNEL_ID>.json

ingress:
  # Flutter web build (ผ่าน Caddy :8081 — SPA fallback + CSP อยู่ที่นั่น)
  - hostname: admin.sheserved.me
    service: http://localhost:8081

  # Root domain — deep-link landing + link files (.well-known)
  - hostname: sheserved.me
    service: http://localhost:8081

  # Backend API + Socket.IO (ผ่าน Caddy :8080 → node :3000)
  - hostname: api.sheserved.me
    service: http://localhost:8080
    originRequest:
      # WebSocket ใช้ได้โดย default — keepalive กัน idle timeout
      keepAliveConnections: 100
      keepAliveTimeout: 1m30s

  # catch-all สุดท้าย (จำเป็น — ต้องมีเสมอ)
  - service: http_status:404
