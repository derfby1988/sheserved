# =============================================================
# Caddyfile.dev — Port 8080 (ไม่ต้อง sudo)
# ใช้สำหรับ: ทดสอบเร็วบน localhost และมือถือในวง Wi-Fi เดียวกัน
# รัน: caddy run --config Caddyfile.dev --adapter caddyfile
#
# Option D: Edge Rate Limiting — ต้องติดตั้ง caddy-ratelimit plugin
#   caddy add-package github.com/mholt/caddy-ratelimit
# หรือถ้าใช้ Caddy มาตรฐาน (ไม่มี plugin) edge limit จะทำงานที่ app layer
# =============================================================

{
	admin off
	auto_https off
}

:8080 {
	log {
		output stdout
		format console
		level INFO
	}

	header {
		-Server
		X-Powered-By "Sheserved-Proxy"
	}

	# Option D: Edge Rate Limiting (requires caddy-ratelimit plugin)
	# แยก zone ตามประเภท traffic — ใช้เป็น coarse defense ก่อนถึง app
	# ถ้าไม่มี plugin ให้ comment ส่วนนี้และพึ่ง app-layer rate limiter
	# rate_limit {
	# 	zone api_read   10r/s 20
	# 	zone api_auth    2r/s  5
	# 	zone api_upload  1r/s  3
	# 	zone emergency  20r/s 50
	# }

	# Auth endpoints — strict limit
	@auth path /api/auth/* /api/login /api/register /api/otp/* /api/verify* /api/reset*
	handle @auth {
		# rate_limit api_auth
		reverse_proxy localhost:3000
	}

	# Upload endpoints — low rate, larger body
	@upload path_regexp ^/api/.*upload
	handle @upload {
		# rate_limit api_upload
		request_body {
			max_size 25MB
		}
		reverse_proxy localhost:3000
	}

	# Emergency endpoints — high burst (ต้องไม่บล็อกฉุกเฉิน)
	@emergency path_regexp ^/api/.*emergency
	handle @emergency {
		# rate_limit emergency
		reverse_proxy localhost:3000
	}

	# WebSocket — no rate limit on handshake, app-layer handles events
	handle /socket.io/* {
		reverse_proxy localhost:3000
	}

	# Default API
	handle {
		# rate_limit api_read
		reverse_proxy localhost:3000 {
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
		}
	}
}

# =============================================================
# Flutter Web build — W4.2 (dev/staging template)
# เสิร์ฟ build/web บน :8081 — SPA fallback + security headers + CSP (W4.4)
# CADDY_WEB_ROOT ตั้งใน .env หรือ default จาก start-caddy.sh
# =============================================================
:8081 {
	log {
		output stdout
		format console
		level INFO
	}

	root * {$CADDY_WEB_ROOT}
	encode zstd gzip

	# ── Security headers + CSP (W4.4) ──
	# script-src: 'wasm-unsafe-eval' จำเป็นสำหรับ canvaskit (WASM);
	#   unpkg = model-viewer; accounts.google.com = GIS credential flow (W3)
	# connect-src: backend API+WebSocket (dev :8080), Supabase REST/Realtime,
	#   Google People/GIS endpoints, fonts, unpkg
	# ⚠️ ตอน staging/prod เปลี่ยน http/ws origins เป็น https/wss domain จริง
	header {
		-Server
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://unpkg.com https://accounts.google.com/gsi/client; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' http://localhost:8080 ws://localhost:8080 http://127.0.0.1:8080 ws://127.0.0.1:8080 http://192.168.1.167:8080 ws://192.168.1.167:8080 https://api.sheserved.me wss://api.sheserved.me https://psxcgdwcwjdbpaemkozq.supabase.co wss://psxcgdwcwjdbpaemkozq.supabase.co https://accounts.google.com https://www.googleapis.com https://unpkg.com https://fonts.googleapis.com https://fonts.gstatic.com; frame-src https://accounts.google.com; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
	}

	# Link files (deep-link → sheserved.me): AASA ไม่มีนามสกุลไฟล์
	# Apple/Android ต้องการ Content-Type: application/json เสมอ
	@linkfiles path /.well-known/* /apple-app-site-association
	header @linkfiles Content-Type "application/json"

	# ── Cache profile (W4.6) ──
	# no-cache ทุกอย่างยกเว้น static dirs (matchers disjoint — Caddy เรียง
	# most-specific ก่อน เลยห้ามให้ global matcher ทับของ static)
	@notStatic not path /canvaskit/* /assets/* /icons/*
	header @notStatic Cache-Control "no-cache"

	@static path /canvaskit/* /assets/* /icons/*
	header @static Cache-Control "public, max-age=86400"

	# ── Deep-link landing (Phase 23 share links) ──
	# ลิงก์แชร์ https://<domain>/emergency/* และ /sport-club/* ที่ผู้รับเปิดใน
	# เบราว์เซอร์ต้องเจอหน้า landing (ปุ่มเปิดแอปผ่าน sheserved:// + ปุ่มเปิดเว็บ
	# ผ่าน /?go=<route>) ไม่ใช่ Flutter shell เปล่า — เครื่องที่มีแอปจะถูก
	# Android App Links / iOS Universal Links intercept ก่อนถึงจุดนี้อยู่แล้ว
	# หน้า landing อยู่ใน web/landing/ (JS แยกไฟล์เพราะ CSP ไม่มี unsafe-inline)
	@deeplinkLanding path /emergency/* /sport-club/*
	rewrite @deeplinkLanding /landing/index.html

	# SPA fallback — route ทั้งหมดตกไป index.html
	try_files {path} /index.html
	file_server
}
